{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowGitSyncAndCloudFormationToAssumeRole",
      "Effect": "Allow",
      "Principal": {
        "Service": [
          "cloudformation.sync.codeconnections.amazonaws.com",
          "cloudformation.amazonaws.com"
        ]
      },
      "Action": "sts:AssumeRole"
    }
  ]
}
